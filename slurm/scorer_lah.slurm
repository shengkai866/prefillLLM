#!/bin/bash
#SBATCH --job-name=pf_scorer_lah
#SBATCH --account=drjieliu
#SBATCH --partition=drjieliu-l40s
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gres=gpu:1
#SBATCH --mem=120G
#SBATCH --time=10:00:00
#SBATCH --output=/nfs/turbo/umms-drjieliu/usr/shengkai/prefillLLM-scorer/logs/%x-%j.out
# Our pipeline with SpecPrefill's scorer and a SHORTER look-ahead: spec:0.1:lahN = N look-ahead queries (last prompt
# token + N-1 tokens generated by the small model; SpecPrefill's default is 8), 32-token chunks by mean, the rest
# projected. N = 2, 3, 4. The baselines (attn_small:0.1:sent and spec:0.1 = look-ahead 8) come from the same code and
# prompts in results/scorer_<tag> (job 28091569). One L40S, scorer-max worktree; main is untouched.
# Per pair: RULER 4k / 8k, QA 4k / 8k, QA 16k / 32k -> results/scorer_lah_<tag>; TTFT (CUDA graph) of every scorer
# -> results/scorer_lah_<tag>_speed; scripts/summarize_lah.py -> results/scorer_lah_summary.md
#   sbatch slurm/scorer_lah.slurm        PAIRS="06" to restrict
set -o pipefail
source /nfs/turbo/umms-drjieliu/usr/shengkai/prefillLLM/slurm/env.sh
cd /nfs/turbo/umms-drjieliu/usr/shengkai/prefillLLM-scorer || exit 1
export PREFILL_FOLD=fused PREFILL_ATTN=triton
CK=$PREFILL_ROOT/checkpoints
M=$PREFILL_ROOT/models
PAIRS=${PAIRS:-"06 17"}
CFG=spec:0.1:lah2,spec:0.1:lah3,spec:0.1:lah4
SPEED=big,attn_small:0.1:sent,spec:0.1:lah2,spec:0.1:lah3,spec:0.1:lah4,spec:0.1,specprefill:0.1
step() { echo; echo "==================== [$(date '+%F %T')] $1 ===================="; }
FAILED=""
git log --oneline -1

for p in $PAIRS; do
  ( unset PREFILL_SMALL_DIR PREFILL_LARGE_DIR PREFILL_DATA_DIR
    case $p in
      06) export PREFILL_SMALL_DIR=$M/Qwen3-0.6B; P=$CK/r2_mix8k/projector.pt; TAG=06 ;;
      17) export PREFILL_SMALL_DIR=$M/Qwen3-1.7B; P=$CK/r5_s17_normB/projector.pt; TAG=17 ;;
      *) echo "unknown pair $p"; exit 1 ;;
    esac
    R=results/scorer_lah_$TAG
    step "$p / speed"  # first: catches a broken graph path in minutes instead of hours
    python scripts/eval_recompute.py --projector $P --out_dir ${R}_speed --tasks speed_allgraph --configs attn_small:0.1:sent \
      --speed_configs $SPEED --speed_lengths 4096,8192,16384,32768 --force || exit 1
    step "$p / quality"
    python scripts/eval_recompute.py --projector $P --out_dir $R --tasks ruler,qa,qa_long --configs $CFG --force || exit 1
  ) || FAILED="$FAILED $p"
done
python scripts/summarize_lah.py
step "all done${FAILED:+ — FAILED:$FAILED}"
[ -z "$FAILED" ]
