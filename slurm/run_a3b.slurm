#!/bin/bash
#SBATCH --job-name=pf_a3b
#SBATCH --account=drjieliu
#SBATCH --partition=drjieliu-l40s
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:2
#SBATCH --mem=160G
#SBATCH --time=3-00:00:00
#SBATCH --output=/nfs/turbo/umms-drjieliu/usr/shengkai/prefillLLM-a3b/logs/%x-%j.out
#SBATCH --mail-user=shengkai@umich.edu
#SBATCH --mail-type=BEGIN,END,FAIL
# REVERSE pair Qwen3-30B-A3B (MoE, 30B total / 3B active; prefills) -> Qwen3-0.6B (decodes); branch reverse-a3b, worktree
# prefillLLM-a3b. Replaces the 8B -> 0.6B runs of short-align / c2c-compare (cancelled 2026-11-13). In code terms the
# 30B-A3B is "small" (source of hidden states / sharer) and the 0.6B is "large" (owner of the cache); PREFILL_TEACHER=small
# makes the 30B-A3B the stage-2 KL teacher. The 30B-A3B (61 GB bf16) does not fit one 48 GB L40S: it is split over the
# job's two GPUs (PREFILL_SMALL_MAXMEM, models.load_split), the 0.6B / projector / optimizer stay on cuda:0.
# Training data = the same Qwen data tree as rev8to06: stage-2 sd_mix4k / sd_mixlong responses were generated by Qwen3-8B
# (not by the 30B-A3B); the KL target is still the 30B-A3B's own distribution on those responses.
#   METHOD=smoke : everything below for a few steps (GPU path of all four methods, all eval configs) -> ckpt a3b_smoke
#   METHOD=rev   : our reverse projector, same recipe as rev8to06: stage 1 in_norm 8000 + stage 2 mix8k 12000;
#                  evals with configs big (0.6B alone), small (30B-A3B alone), hyb                -> results/rev30a3to06_*
#   METHOD=sa1k  : variant B (short alignment): stage 1 only 1000 steps, then the same stage 2; config hyb
#                                                                                                 -> results/sa1k_rev30a3to06_*
#   METHOD=e3    : C2C fuser architecture + our objective (KL to the 30B-A3B + 0.1 NLL, sd_mix 8k, 12000 x 4); hyb
#                                                                                                 -> results/c2c_e3_rev30a3to06_*
#   METHOD=e2    : C2C's official recipe (official trainer, OpenHermes-2.5 first 130k, ~500 steps of 256); hyb
#                                                                                                 -> results/c2c_e2_rev30a3to06_*
# Eval per method: KL to the 30B-A3B per data type (+ KL/retrieval per checkpoint), NIAH / RULER / QA / GSM8K / code,
# QuALITY. Restart: sbatch --export=ALL,METHOD=<m>,START_AT=<step> slurm/run_a3b.slurm
set -o pipefail
source /nfs/turbo/umms-drjieliu/usr/shengkai/prefillLLM/slurm/env.sh
cd /nfs/turbo/umms-drjieliu/usr/shengkai/prefillLLM-a3b || exit 1
M=$PREFILL_ROOT/models
export PREFILL_SMALL_DIR=$M/Qwen3-30B-A3B PREFILL_LARGE_DIR=$M/Qwen3-0.6B PREFILL_TEACHER=small
export PREFILL_FOLD=eager  # the fused fold kernel is only validated for forward pairs; speed is not measured here
# 30B-A3B weights = 56.9 GiB: ~22 GiB on cuda:0 (which also holds the 0.6B, projector, optimizer, student activations),
# the rest (~35 GiB + lm_head, teacher logits / KL) on cuda:1
export PREFILL_SMALL_MAXMEM=${PREFILL_SMALL_MAXMEM:-22GiB,44GiB}
export PREFILL_C2C_DIR=$PREFILL_ROOT/ext/C2C
METHOD=${METHOD:-rev}
PT=rev30a3to06
CK=$PREFILL_ROOT/checkpoints
case $METHOD in
  smoke) TAG=a3b_smoke ;;
  rev)   TAG=$PT ;;
  sa1k)  TAG=sa1k_$PT ;;
  e3|e2) TAG=c2c_${METHOD}_$PT ;;
  *) echo "unknown METHOD $METHOD"; exit 1 ;;
esac
R=results/$TAG
echo "METHOD=$METHOD tag $TAG; worktree $(pwd) branch $(git rev-parse --abbrev-ref HEAD) $(git rev-parse --short HEAD);" \
     "source $PREFILL_SMALL_DIR (split $PREFILL_SMALL_MAXMEM) -> decoder $PREFILL_LARGE_DIR, teacher = source"
nvidia-smi --query-gpu=index,name,memory.used,memory.total --format=csv
START_AT=${START_AT:-$([[ $METHOD == smoke ]] && echo smoke || echo train)}
run=0
step() { echo; echo "==================== [$(date '+%F %T')] $1 ===================="; }
should() { if [[ $run == 1 || $1 == "$START_AT" ]]; then run=1; return 0; fi; return 1; }
FAILED=""
ev() { "$@" || { FAILED="$FAILED $1:$3"; echo "!!!!!!!! FAILED: $*"; }; }  # isolated eval step

# C2C official recipe (E2) for this pair; $1 = output dir, $2 = number of OpenHermes samples, $3 = gradient accumulation
e2_recipe() {
  mkdir -p $1
  cat > $1/recipe.json <<EOF
{
  "model": {
    "base_model": "$M/Qwen3-0.6B",
    "teacher_model": "$M/Qwen3-30B-A3B",
    "is_do_alignment": false,
    "alignment_strategy": "first",
    "projector": {"type": "C2CProjector", "params": {"hidden_dim": 1024, "intermediate_dim": 1024, "num_layers": 3,
      "dropout": 0.1, "initial_temperature": 1.0, "final_temperature": 0.001, "anneal_steps": 500}},
    "mapping": "last_aligned"
  },
  "training": {"learning_rate": 1e-4, "weight_decay": 0.01, "num_epochs": 1, "max_length": 2048, "device": "cuda",
    "scheduler_type": "linear", "warmup_ratio": 0.1, "max_grad_norm": 1.0, "gradient_accumulation_steps": $3,
    "per_device_train_batch_size": 4, "num_processes": 1, "freeze": ["teacher", "base"], "seed": 42},
  "output": {"output_dir": "$1", "save_steps": 250, "eval_steps": 100,
    "wandb_config": {"project": "Rosetta", "mode": "disabled", "entity": null, "run_name": "$(basename $1)"}},
  "data": {"type": "OpenHermesChatDataset", "kwargs": {"split": "train", "max_word_count": 2048, "num_samples": $2},
    "train_ratio": 0.99}
}
EOF
}
e2_train() {  # official trainer, sharer split over the GPUs; drop any whole-model dumps afterwards
  PREFILL_C2C_TEACHER_MAXMEM=$PREFILL_SMALL_MAXMEM python scripts/c2c_official_train.py --config $1/recipe.json || return 1
  rm -f $1/final/model.pt $1/checkpoint-*/model.pt
}

if [[ $METHOD == smoke ]]; then
  set -e
  SM=$CK/$TAG
  rm -rf $SM
  step "smoke 1/5: CPU tests (MoE forward / FastQwen3 MoE == HF; C2C == official RosettaModel)"
  python tests/test_moe.py
  python tests/smoke_c2c.py
  step "smoke 2/5: our projector, stage 1 + stage 2 a few steps, tiny evals with every config (big, small, hyb)"
  python scripts/train_stage1.py --in_norm --out_dir $SM/s1 --max_steps 6 --accum 2 --val_every 3 --val_seqs 2 --save_every 1000
  python scripts/train_stage2.py --init $SM/s1/projector.pt --out_dir $SM/s2 --max_steps 4 --accum 2 \
    --val_every 2 --val_per_type 1 --save_every 1000 --save_step_every 0 --sd sd_mix4k,sd_mixlong --max_prompt 8064 --curriculum_frac 0
  python scripts/evaluate_v2.py --projectors rev=$SM/s2/projector.pt --baselines big --tasks kl --n_kl 1 --out_dir $SM/e_v2
  python scripts/eval_recompute.py --projector $SM/s2/projector.pt --out_dir $SM/e_main --tasks niah,gsm8k,quality \
    --configs big,small,hyb --n_gsm8k 2 --n_quality 3
  grep -h "KL" -A4 $SM/e_v2/summary.md | head -6 || true
  step "smoke 3/5: C2C E3 (our objective) a few steps + tiny evals"
  python scripts/train_stage2.py --init c2c --out_dir $SM/e3 --max_steps 4 --accum 2 --lr 1e-4 --warmup 1 \
    --val_every 2 --val_per_type 1 --save_every 1000 --save_step_every 0 --sd sd_mix4k,sd_mixlong --max_prompt 8064 --curriculum_frac 0
  python scripts/evaluate_v2.py --projectors e3=$SM/e3/projector.pt --baselines big --tasks kl --n_kl 1 --out_dir $SM/e3/e_v2
  python scripts/eval_recompute.py --projector $SM/e3/projector.pt --out_dir $SM/e3/e_main --tasks niah,gsm8k --configs hyb --n_gsm8k 2
  step "smoke 4/5: C2C E2 (official trainer, split sharer) on 64 OpenHermes samples, then a tiny eval of its fuser"
  e2_recipe $SM/e2 64 2
  e2_train $SM/e2
  python scripts/eval_recompute.py --projector $SM/e2/final --out_dir $SM/e2/e_main --tasks niah,gsm8k --configs hyb --n_gsm8k 2
  step "smoke 5/5: GPU memory"
  nvidia-smi --query-gpu=index,memory.used,memory.total --format=csv
  set +e
  step "smoke passed"
  exit 0
fi

if [[ $METHOD == rev || $METHOD == sa1k ]]; then
  S1=$CK/${TAG}_stage1
  S2=$CK/${TAG}_mix8k
  P=$S2/projector.pt
  if [[ $METHOD == rev ]]; then CFG=big,small,hyb; else CFG=hyb; fi  # sa1k: baselines are in results/rev30a3to06_*
  if should train; then
    if [[ $METHOD == rev ]]; then
      step "stage1: 30B-A3B hidden states -> 0.6B residual streams, in_norm, 8000 steps"
      python scripts/train_stage1.py --in_norm --out_dir $S1 --max_steps 8000 --accum 4 --lr 2e-4 --time_budget_hours 20 \
        --resume $S1/projector.pt || exit 1
    else
      step "stage1 (short, 1000 steps): 30B-A3B hidden states -> 0.6B residual streams, in_norm"
      python scripts/train_stage1.py --in_norm --out_dir $S1 --max_steps 1000 --warmup 100 --val_every 250 --accum 4 --lr 2e-4 \
        --time_budget_hours 20 --resume $S1/projector.pt || exit 1
    fi
  fi
  if should stage2; then
    step "stage2: KL to the 30B-A3B, mixed data, prompts <= 8k (mix8k recipe), 12000 steps"
    python scripts/train_stage2.py --init $S1/projector.pt --max_steps 12000 --accum 4 --lr 5e-5 --warmup 100 \
      --val_every 500 --val_per_type 2 --save_every 500 --save_step_every 2000 --time_budget_hours 40 \
      --sd sd_mix4k,sd_mixlong --max_prompt 8064 --out_dir $S2 || exit 1
  fi
  CURVE="kl,curve --curve_runs $TAG=$S2"
elif [[ $METHOD == e3 ]]; then
  P=$CK/$TAG/projector.pt
  CFG=hyb
  if should train; then
    step "train: C2C fuser, KL to the 30B-A3B + 0.1 NLL, mixed data, prompts <= 8k, 12000 steps"
    python scripts/train_stage2.py --init c2c --max_steps 12000 --accum 4 --lr 1e-4 --warmup 1200 --wd 0.01 \
      --val_every 500 --val_per_type 2 --save_every 500 --save_step_every 2000 --time_budget_hours 40 \
      --sd sd_mix4k,sd_mixlong --max_prompt 8064 --out_dir $CK/$TAG || exit 1
  fi
  CURVE="kl,curve --curve_runs $TAG=$CK/$TAG"
else  # e2
  P=$CK/$TAG/final
  CFG=hyb
  if should train; then
    step "train: official C2C trainer, OpenHermes-2.5 first 130k, ~500 steps of 256 (4 x accum 64)"
    e2_recipe $CK/$TAG 130000 64
    e2_train $CK/$TAG || exit 1
  fi
  CURVE="kl"
fi

if should eval_v2; then
  step "eval: KL vs the 30B-A3B per data type (0.6B alone and $METHOD)"
  ev python scripts/evaluate_v2.py --projectors $TAG=$P --baselines big --tasks $CURVE --out_dir ${R}_v2
fi
if should main; then
  step "eval main: NIAH / RULER / QA / GSM8K / code, configs $CFG"
  ev python scripts/eval_recompute.py --projector $P --out_dir ${R}_main --tasks niah,ruler,qa,gsm8k,code --configs $CFG
fi
if should quality; then
  step "eval QuALITY (single question), configs $CFG"
  ev python scripts/eval_recompute.py --projector $P --out_dir ${R}_quality --tasks quality --configs $CFG
fi
step "all done${FAILED:+ — FAILED:$FAILED}"
[ -z "$FAILED" ]
